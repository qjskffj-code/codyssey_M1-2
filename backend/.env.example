# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 개발 중 과금 방지를 위한 응답 토큰 상한
OPENAI_MAX_TOKENS=500

# ===== Firebase (둘 중 하나만 설정) =====
# 로컬 개발: 서비스 계정 JSON 파일 경로 (프로젝트 폴더 밖에 두는 것을 권장)
FIREBASE_SERVICE_ACCOUNT_PATH=
# 배포(Render): JSON 파일 내용 전체를 한 줄로
FIREBASE_SERVICE_ACCOUNT_JSON=

# ===== CORS =====
# 허용할 프론트엔드 주소 (쉼표로 구분). 배포 후 Vercel 주소를 추가한다.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ===== 공공데이터포털 (관광 빅데이터 수집용, 일반 인증키 Decoding) =====
DATA_GO_KR_API_KEY=
